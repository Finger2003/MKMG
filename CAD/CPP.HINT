#define DEFINE_TYPE(BaseType, EnumVal) static constexpr ObjectType ClassType =EnumVal; bool IsA(ObjectType t) const override { return t == ClassType || BaseType::IsA(t); }
#define DEFINE_SCHEMA(SchemaString) static constexpr const char* SchemaName = SchemaString; const char* GetSchemaType() const override { return SchemaName; }
#define SCENE_OBJECT_LIST(X) X(TransformableObject) X(Point) X(Torus) X(Curve) X(BezierCurve) X(BSplineCurve) X(InterpolatingCurve)
#define AS_ENUM(Name)
